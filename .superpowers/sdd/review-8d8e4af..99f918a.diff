+
+.doc-header__fach {
+  font-family: 'Liberation Sans', sans-serif;
+  font-size: 11px;
+  letter-spacing: 1px;
+  text-transform: uppercase;
+  color: #555;
+}
+
+.doc-header__title {
+  font-size: 21px;
+  font-weight: bold;
+  margin-top: 4px;
+}
+
+.doc-header__meta {
+  font-family: 'Liberation Sans', sans-serif;
+  font-size: 11px;
+  color: #777;

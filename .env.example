# Webhook receiver
RECEIVER_PORT=3000

# Redis (job queue)
REDIS_URL=redis://localhost:6379

# Azure AD app registration (client-credentials flow)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Arbitrary secret Microsoft echoes back on each notification, used to verify authenticity
GRAPH_WEBHOOK_CLIENT_STATE=
# Public URL of the webhook receiver, e.g. behind a Cloudflare Tunnel
GRAPH_NOTIFICATION_URL=https://example.com/webhook

# Claude Agent SDK
ANTHROPIC_API_KEY=

# Nextcloud (same host as the worker, direct data-dir write)
NEXTCLOUD_DATA_DIR=/var/www/nextcloud/data
NEXTCLOUD_TARGET_USER=
NEXTCLOUD_OCC_BIN=/var/www/nextcloud/occ

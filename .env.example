# Redis (job queue) - defaults to localhost because redis, ingest, and worker all share the
# tailscale sidecar's network namespace (see docker-compose.yml); there's no Compose-DNS
# service-name lookup happening once they're on that shared namespace.
REDIS_URL=redis://localhost:6379

# Ingest watcher - folder watched for manually-downloaded files (zips, PDFs, etc.)
# Point this at a Nextcloud-synced folder (e.g. one you upload exported Teams files into from
# your phone/browser) to get "drop a file in Nextcloud, it gets processed" with no extra step.
# Must be an absolute path: this is the path as seen by the worker process, whether run
# directly (`npm run dev:worker`) or in Docker (where it's also the in-container mount point -
# see INGEST_WATCH_DIR_HOST in docker-compose.yml for the host-side source of that mount).
# Default changed to __INBOX__ to match the naming convention of the prior schule-loesen skill.
INGEST_WATCH_DIR=/app/__INBOX__
# Subfolders of INGEST_WATCH_DIR that handled files are moved into - never point these outside
# INGEST_WATCH_DIR, and don't drop files directly into them.
INGEST_PROCESSED_DIRNAME=.processed
INGEST_FAILED_DIRNAME=.failed
INGEST_STAGING_DIRNAME=.staging
# Milliseconds a dropped file must sit unmodified before it's treated as fully written
# (avoids ingesting a file mid-copy/mid-upload).
INGEST_STABILITY_THRESHOLD_MS=2000

# Web Dashboard & Remote Tailnet Access
WEB_PORT=3000
# Enable Tailscale Serve (automatic HTTPS certificate on MagicDNS domain https://<hostname>.<tailnet>.ts.net)
TS_SERVE=false

# Banking Integration (FinTS 3.0 / HBCI - German & EU PSD2 banks)
# Common bank BLZs: DKB (12030000), ING (50010517), Commerzbank (37020500), Sparkasse (varies by city)
FINTS_BLZ=
FINTS_USER=
FINTS_PIN=
# FinTS server endpoint URL (optional if standard bank BLZ, or specify e.g. https://banking.dkb.de/fints/service)
FINTS_ENDPOINT=
# Target account IBAN to sync (optional, syncs all accounts if unset)
FINTS_IBAN=
# Optional TAN medium name if bank requires choosing one (e.g. pushTAN, photoTAN)
FINTS_TAN_MEDIUM=
# Periodic auto-sync interval in hours (default: 24, set to 0 to disable automatic background syncing)
FINTS_AUTO_SYNC_INTERVAL_HOURS=24
# Sync transactions (default: true)
FINTS_SYNC_TRANSACTIONS=true
# Fetch and download electronic bank statements (default: true)
FINTS_SYNC_STATEMENTS=true
# Directory to store downloaded statements (default: ./data/banking/statements)
FINTS_DESTINATION_FOLDER=./data/banking/statements
# Automatically copy downloaded PDF bank statements into the ingest watch dir (__INBOX__) so they are OCR'd and archived
FINTS_AUTO_INGEST_STATEMENTS=true
# Set to true to enable mock banking data (useful for testing or before entering live bank credentials)
FINTS_MOCK=false

# Claude Agent SDK
# Optional: only needed for API-key billing. Leave unset to authenticate the Claude Agent
# SDK subprocess via a Claude Pro/Max subscription login instead (run `claude login` in
# the environment the worker runs in) - Agent SDK usage draws from subscription rate
# limits, not a separate credit.
ANTHROPIC_API_KEY=
# Optional: model used for task extraction fallback. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# Gemini (agy) primary provider configuration
PASS1_MODEL=gemini-3.6-flash
PASS1_EFFORT=medium
PASS2_MODEL=gemini-3.1-pro
PASS2_EFFORT=high
AGY_PRINT_TIMEOUT=5m
AGY_BIN=agy
# Docker-only, read by docker-compose.yml (not by the Node app itself, same as
# INGEST_WATCH_DIR_HOST): absolute host path to a `~/.gemini` directory produced by running
# `agy` interactively on the host once to authenticate it, then mounted read-write into the
# worker container so it can use that same login headlessly. UNVERIFIED - see
# docs/superpowers/specs/2026-07-24-gemini-agy-integration-design.md ("Infra changes") for
# the open risk this hasn't been confirmed to actually work across machines/OSes.
AGY_CREDENTIAL_DIR_HOST=

# Nextcloud - reached over Tailscale via WebDAV (see the tailscale service in
# docker-compose.yml), not by sharing a filesystem/host with Nextcloud.
NEXTCLOUD_BASE_URL=https://nextcloud.<your-tailnet>.ts.net
NEXTCLOUD_USERNAME=
# Create under Nextcloud's Settings > Security > "Create new app password" - scoped to one
# account, revocable independently of the login password.
NEXTCLOUD_APP_PASSWORD=

# Tailscale sidecar (docker/tailscale/) - joins the tailnet and drains Taildrop-sent files.
# TS_AUTHKEY holds an OAuth client secret (format tskey-client-...?ephemeral=false), not a
# classic auth key - create an OAuth client under the Tailscale admin console's Settings >
# OAuth clients, and a `tag:delet-school` ACL tag in the tailnet's ACL policy (OAuth-issued
# keys require a tag).
TS_AUTHKEY=
TS_HOSTNAME=delet-school
# Shared volume path both the tailscale sidecar and the ingest container mount - must match
# between the two (see docker-compose.yml).
TAILDROP_STAGING_DIR=/taildrop-staging
TAILDROP_POLL_INTERVAL_MS=5000

# Student metadata (used in the solved-PDF frontmatter)
STUDENT_NAME=
STUDENT_CLASS=

# Subjects the pipeline classifies documents into and files solutions under. JSON array of
# {"key": "...", "folder": "...", "language": "..."} — "language" is optional and overrides
# OUTPUT_LANGUAGE for that subject (e.g. a language class should be solved in the language
# being taught, not translated into OUTPUT_LANGUAGE). Defaults to a generic Math/Science/
# History/English/Spanish/Unsorted set if unset — see src/subjects.ts.
SUBJECTS=

# Language the model writes generated solution text in (topic, background context, task
# descriptions, proposed solutions, sources). Source documents themselves are read in whatever
# language they actually are. Defaults to English.
OUTPUT_LANGUAGE=

# PDF extraction toolchain (installed system-wide/venv in the Docker image - see docker/Dockerfile)
PDFTOTEXT_BIN=pdftotext
PDFTOPPM_BIN=pdftoppm
PDFINFO_BIN=pdfinfo
OCRMYPDF_BIN=ocrmypdf
OCR_LANGUAGES=deu+eng
MARKITDOWN_BIN=/app/.venv/bin/markitdown

# Solution-PDF generation (pandoc + weasyprint)
PANDOC_BIN=pandoc
PANDOC_TEMPLATE_PATH=/app/template/template.html
PANDOC_CSS_PATH=/app/template/style.css
WEASYPRINT_BIN=/app/.venv/bin/weasyprint

# Dictionaries for the OCR-quality gate's real-word check (src/extract/dictionary.ts) -
# installed via apt (hunspell-de-de, hunspell-en-us) at these standard Debian paths in the
# Docker image; only need overriding for local (non-Docker) runs.
HUNSPELL_DE_DIC_PATH=/usr/share/hunspell/de_DE.dic
HUNSPELL_EN_DIC_PATH=/usr/share/hunspell/en_US.dic

# Redis (job queue)
REDIS_URL=redis://localhost:6379

# Ingest watcher - folder watched for manually-downloaded files (zips, PDFs, etc.)
# Point this at a Nextcloud-synced folder (e.g. one you upload exported Teams files into from
# your phone/browser) to get "drop a file in Nextcloud, it gets processed" with no extra step.
# Must be an absolute path: this is the path as seen by the worker process, whether run
# directly (`npm run dev:worker`) or in Docker (where it's also the in-container mount point -
# see INGEST_WATCH_DIR_HOST in docker-compose.yml for the host-side source of that mount).
INGEST_WATCH_DIR=/app/inbox
# Subfolders of INGEST_WATCH_DIR that handled files are moved into - never point these outside
# INGEST_WATCH_DIR, and don't drop files directly into them.
INGEST_PROCESSED_DIRNAME=.processed
INGEST_FAILED_DIRNAME=.failed
INGEST_STAGING_DIRNAME=.staging
# Milliseconds a dropped file must sit unmodified before it's treated as fully written
# (avoids ingesting a file mid-copy/mid-upload).
INGEST_STABILITY_THRESHOLD_MS=2000

# Claude Agent SDK
# Optional: only needed for API-key billing. Leave unset to authenticate the Claude Agent
# SDK subprocess via a Claude Pro/Max subscription login instead (run `claude login` in
# the environment the worker runs in) - Agent SDK usage draws from subscription rate
# limits, not a separate credit.
ANTHROPIC_API_KEY=
# Optional: model used for task extraction. Defaults to claude-haiku-4-5-20251001 (this
# call is simple, high-volume extraction, not worth a larger model by default).
ANTHROPIC_MODEL=

# Nextcloud (same host as the worker, direct data-dir write)
NEXTCLOUD_DATA_DIR=/var/www/nextcloud/data
NEXTCLOUD_TARGET_USER=
NEXTCLOUD_OCC_BIN=/var/www/nextcloud/occ

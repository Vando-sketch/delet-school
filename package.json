{
  "name": "teams-task-agent",
  "version": "0.1.0",
  "description": "Detects files shared in Microsoft Teams, processes them with the Claude Agent SDK to find and solve open tasks, and distributes the result to Nextcloud.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:receiver": "tsx watch src/receiver/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:receiver": "node dist/receiver/index.js",
    "start:worker": "node dist/worker/index.js",
    "renew-subscription": "tsx scripts/renew-subscription.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@azure/msal-node": "^2.13.1",
    "bullmq": "^5.12.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "eslint": "^9.9.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}

{
  "name": "teams-task-agent",
  "version": "0.1.0",
  "description": "Watches a local folder for manually-downloaded files (zips, PDFs, etc.), processes them with the Claude Agent SDK to find and solve open tasks, and distributes the result to Nextcloud.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:ingest": "tsx watch src/ingest/watcher.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:ingest": "node dist/ingest/watcher.js",
    "start:worker": "node dist/worker/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "adm-zip": "^0.6.0",
    "bullmq": "^5.12.7",
    "chokidar": "^5.0.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.14.15",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "eslint": "^9.9.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
